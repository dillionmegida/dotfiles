# ======================
# FONT
# ======================
font-family = JetBrainsMono Nerd Font   # Main font (Nerd Font for icons/glyphs in oh-my-zsh)
font-size = 16                          # Base font size
font-feature = calt                     # Contextual alternates (smart ligatures)
font-feature = liga                     # Standard ligatures (e.g. -> becomes →)

# ======================
# QUICK TERMINAL (Dropdown)
# ======================
keybind = global:ctrl+grave_accent=toggle_quick_terminal  # Ctrl+` to toggle dropdown terminal from anywhere
quick-terminal-position = top                             # Slides down from top of screen
quick-terminal-screen = main                              # Appears on main monitor
quick-terminal-animation-duration = 0.2                  # Slide animation speed in seconds

# ======================
# WINDOW
# ======================
window-padding-x = 20              # Horizontal padding inside the window
window-padding-y = 5               # Vertical padding inside the window
macos-titlebar-style = tabs        # Show tab bar (required to see tabs with Cmd+T)
background-opacity = 0.95          # Slight transparency (1.0 = fully opaque)
background-blur-radius = 20        # Frosted glass blur behind transparent background
macos-option-as-alt = true         # Makes Option key behave as Alt (needed for many CLI shortcuts)
window-padding-balance = true      # Distributes padding evenly around splits

# ======================
# BEHAVIOUR
# ======================
copy-on-select = true              # Automatically copies text when you select it
mouse-hide-while-typing = true     # Hides mouse cursor while typing, reappears on move
scrollback-limit = 100000          # Lines of scrollback history to keep in memory

# ======================
# CURSOR
# ======================
cursor-style = bar                 # Thin vertical line cursor (vs block or underline)
cursor-style-blink = true          # Cursor blinks

# ======================
# THEME
# ======================
theme = Breadog                    # Color theme (run `ghostty +list-themes` to browse)

# ======================
# SPLITS
# ======================
split-divider-color = #f1a296      # Color of the line between splits
resize-overlay = always            # Always show resize overlay when adjusting split size

# ======================
# KEYBINDS
# ======================
keybind = cmd+t=new_tab                        # New tab
keybind = cmd+d=new_split:right                # Split current pane vertically (side by side)
keybind = cmd+shift+d=new_split:down           # Split current pane horizontally (top/bottom)
keybind = cmd+w=close_surface                  # Close current split, tab, or window
keybind = cmd+shift+enter=toggle_split_zoom    # Maximize/restore current split (like iTerm2's Cmd+Shift+Enter)